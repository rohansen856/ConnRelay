# coturn for the on-device lab (bound to this machine's LAN address).
listening-ip=@LAN_IP@
relay-ip=@LAN_IP@
listening-port=3478
min-port=49160
max-port=49200
realm=devicelab.invalid
fingerprint
use-auth-secret
static-auth-secret=TEST-ONLY-devicelab-secret
no-tls
no-dtls
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
allowed-peer-ip=@LAN_IP@
log-file=stdout
simple-log
